# --- Postgres (db service + ELT connection) ---
POSTGRES_USER=dxb
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=dxb

# ELT connection (host defaults: localhost from host runs, overridden to `db` in compose)
DXB_DB_HOST=localhost
DXB_DB_PORT=5432

# --- Collector ---
DXB_PAGE_SIZE=500
DXB_THROTTLE_SECONDS=0.4
# Concurrent in-flight page requests. The DLD gateway is undocumented and
# sits behind Cloudflare with no published rate limits, so this is a
# deliberately moderate default: per-page server latency (not our throttle)
# is the real bottleneck, so raising this is the actual speed lever, but
# too high risks the client IP getting blocked outright. Raise cautiously.
DXB_MAX_CONCURRENCY=5
DXB_SOURCE_URL=https://dubailand.gov.ae/en/open-data/real-estate-data/

# --- Scheduler (daily pipeline) ---
# DXB_SCHEDULE_HOUR/MINUTE are local container time, per TZ below.
DXB_SCHEDULE_HOUR=2
DXB_SCHEDULE_MINUTE=30
TZ=Asia/Dubai

# --- Job-level retries (tenacity around the whole daily run) ---
DXB_JOB_ATTEMPTS=3
DXB_JOB_WAIT_MIN_SECONDS=300
DXB_JOB_WAIT_MAX_SECONDS=3600

# --- SMTP alerting (leave SMTP_HOST empty to disable sending; runs are always logged to etl_run) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=1
ALERT_TO=serjdukareff@gmail.com
ALERT_FROM=dxb-elt@localhost

# --- Read-only API service ---
# Connects as the dxb_readonly role created by alembic migration 0003, NOT as
# the ELT's read-write user. Migration 0003 reads this password from the env.
DXB_API_DB_USER=dxb_readonly
DXB_API_DB_PASSWORD=change_me_local_only
DXB_API_DB_POOL_SIZE=10
DXB_API_STATEMENT_TIMEOUT_MS=15000

# JWT signing. Leave DXB_JWT_PRIVATE_KEY empty for local dev and the service
# generates an ephemeral RSA key at startup (tokens die with the process, and
# it logs a warning). Set it — or DXB_JWT_PRIVATE_KEY_FILE — anywhere real.
DXB_JWT_PRIVATE_KEY=
DXB_JWT_KID=dxb-api-1
DXB_JWT_ISSUER=dxb-api
DXB_JWT_AUDIENCE=dxb-clients
DXB_ACCESS_TTL_SECONDS=900
DXB_REFRESH_TTL_SECONDS=604800

# Users live in config, not in a table — that is what keeps the API's
# no-writes-ever guarantee intact. password_hash is argon2id; generate with:
#   uv run --project api python -c "from dxb_api.auth import hash_password; print(hash_password('yourpass'))"
# NOTE the '$' characters in an argon2 hash must be doubled ('$$') in this
# file, because Docker Compose interpolates '$' when it loads it.
DXB_API_USERS=[]

# API keys for the MCP server and our own UI. key_hash is a SHA-256 hex digest
# (fast on purpose: an API key is high-entropy, and it is checked on every
# request, unlike a password which is checked once per login). Generate with:
#   uv run --project api python -c "import secrets;from dxb_api.auth import hash_api_key;k=secrets.token_urlsafe(32);print(k, hash_api_key(k))"
DXB_API_KEYS=[]

# Local-dev escape hatch: 1 disables auth entirely. Off by default.
DXB_AUTH_DISABLED=0

# Query bounds (LLM safety: see docs/API_DESIGN.md §6)
DXB_MAX_PAGE_LIMIT=1000
DXB_MAX_ENTITY_IDS=200
DXB_DEFAULT_MIN_SAMPLE=20
DXB_TRGM_THRESHOLD=0.30
