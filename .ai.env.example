# Copy to .ai.env and fill in. (.ai.env itself is gitignored.)
#
# Option A — DeepSeek directly (what the AI Assistant is designed for).
#   Get a key at https://platform.deepseek.com. The API is OpenAI-compatible.
#   "deepseek-chat" points at the latest DeepSeek-V3.x; set AI_MODEL to any
#   newer DeepSeek model name (e.g. deepseek-v4) when released.
AI_API_KEY=sk-your-deepseek-key-here
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat

# Option B — reuse the running local cli-proxy-api (127.0.0.1:8317) instead.
# Uncomment and comment out Option A. Pick any model it exposes (see /v1/models).
# AI_API_KEY=sk-local-proxy-key-2024
# AI_BASE_URL=http://127.0.0.1:8317
# AI_MODEL=gpt-5.6-terra

# Optional: change the proxy port (default 8787).
# AI_PORT=8787
